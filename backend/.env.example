APP_ENV=production
# generate with: openssl rand -hex 48
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=postgresql+asyncpg://bookverse:bookverse@db:5432/bookverse
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
PUBLIC_API_URL=https://api.yourdomain.com
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=you@example.com

# Uploads: leave S3_BUCKET empty to store covers/avatars on local disk (/uploads).
S3_BUCKET=
# optional CloudFront URL in front of the bucket
S3_PUBLIC_URL=
AWS_REGION=eu-central-1

# Email (SES SMTP credentials or any SMTP provider). Links are logged to the console when empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BookVerse <hello@yourdomain.com>

# Demo community for local dev only — must be false in production.
SEED_ON_START=false
